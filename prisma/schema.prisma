datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  ime       String
  prezime   String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lokacija  String   @default("Sarajevo")

  // Relation with post
  posts   Post[]
  Comment Comment[]
  likes   Likes[]


  // Marketplace relations (replaces BookList/StudentEquipment relations)
  marketplaceItemsForSale     MarketplaceItem[] @relation("MarketplaceSeller")
  marketplaceItemsPurchased   MarketplaceItem[] @relation("MarketplaceBuyer")
}



model Post {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  ime        String
  prezime    String
  naslov     String
  tekst      String
  datum      DateTime @default(now())
  lajkovi    Int      @default(0)
  kategorija String   @default("fakultet")

  likes   Likes[]
  Comment Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
}

model Likes {
  id     Int @id @default(autoincrement())
  userId Int
  postId Int

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

// Book for marketplace
enum ItemType {
  BOOK
  EQUIPMENT
  COURSE
}

enum EquipmentCategory {
  LAPTOP
  TABLET
  KALKULATOR
  LAB_OPREMA
  SKOLSKI_PRIBOR
  TEHNICKA_OPREMA
  OSTALO
}

// Market place item
model MarketplaceItem {
  id         Int                @id @default(autoincrement())
  type       ItemType
  title      String
  // generic optional fields for different item types
  author     String?            // useful for BOOK
  subject    String?            // useful for BOOK
  brand      String?            // useful for EQUIPMENT
  model      String?            // useful for EQUIPMENT
  faculty    String?            // common
  category   EquipmentCategory? // optional, only for equipment
  condition  String?            // or change to enum later
  price      Decimal            @db.Decimal(10,2)
  description String?
  images     String[]           @default([])       // postgres string array of urls
  metadata   Json?                                // flexible per-type data (ISBN, pages, warranty...)

  isSold     Boolean            @default(false)
  isArchived Boolean            @default(false)
  slug       String?            @unique

  sellerId   Int
  seller     User               @relation("MarketplaceSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  buyerId    Int?
  buyer      User?              @relation("MarketplaceBuyer", fields: [buyerId], references: [id])

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([sellerId])
  @@index([isSold])
  @@index([type])
  @@index([category])
  @@index([faculty])
}


